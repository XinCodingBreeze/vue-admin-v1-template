{
  "name": "vite-project",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "router": "node ./src/start/index.js",
    "predev": "npm run router",
    "dev": "vite --host --port 3000 --mode dev",
    "prebuild": "npm run router",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "commit": "czg",
    "prepare": "husky"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.8.4",
    "element-plus": "^2.8.4",
    "file-saver": "^2.0.5",
    "lodash": "^4.17.21",
    "pinia": "^3.0.1",
    "pinia-plugin-persistedstate": "^4.2.0",
    "tesseract.js": "^6.0.0",
    "v-resize-hx": "^0.0.1",
    "vue": "^3.4.37",
    "vue-router": "^4.4.5",
    "wangeditor": "^4.7.15",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.22.0",
    "@vitejs/plugin-vue": "^5.1.2",
    "cz-git": "^1.13.0",
    "czg": "^1.13.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.5.3",
    "puppeteer": "^24.42.0",
    "sass": "^1.85.1",
    "typescript-eslint": "^8.26.1",
    "unplugin-auto-import": "^0.19.0",
    "vite": "^5.4.1",
    "vite-plugin-compression": "^0.5.1"
  },
  "lint-staged": {
    "*.{js,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss}": [
      "prettier --write"
    ],
    "*.{json,md,html}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git",
      "czConfig": "./cz.config.cjs"
    }
  }
}
